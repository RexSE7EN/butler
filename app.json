{
  "expo": {
    "name": "Butler",
    "slug": "butler",
    "scheme": "butler",
    "version": "0.0.1",
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-pattern.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      "expo-router",
      "expo-asset"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.rexseven.butler"
    },
    "android": {
      "package": "io.github.rexseven.butler",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b980ad43-b0ac-42a3-9274-2f5018f76cc7"
      },
      "router": {}
    },
    "owner": "rexseven"
  }
}
